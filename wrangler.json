{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chicken-meeting-backend",
  "main": "backend/server.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "TIMEZONE": "Asia/Shanghai",
    "TENCENT_MCP_URL": "https://mcp.meeting.tencent.com/mcp/wemeet-open/v1",
    "TENCENT_MCP_SKILL_VERSION": "v1.0.11",
    "TENCENT_MCP_PROTOCOL_VERSION": "2025-06-18",
    "TENCENT_MCP_TIMEOUT_MS": "20000",
    "ADMIN_USERNAME": "admin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chicken_meeting_db",
      "database_id": "5ad05cac-b1c9-4ab1-a81f-8aefec72a547"
    }
  ]
}
